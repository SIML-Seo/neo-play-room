{
  "rules": {
    ".read": false,
    ".write": false,

    "lobby": {
      "waitingPlayers": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null"
        }
      }
    },

    "gameRooms": {
      ".read": "auth != null",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('players').child(auth.uid).exists()",

        "aiPlayerId": {
          ".read": false,
          ".write": false
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },

        "turns": {
          "$turnNumber": {
            "answers": {
              "$anonymousId": {
                "isAI": {
                  ".read": false
                }
              }
            }
          }
        }
      }
    }
  }
}
