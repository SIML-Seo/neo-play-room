# Frontend Production Environment Variables
# 상용 환경 전용 설정

# 환경 구분
VITE_ENV=PROD

# Firebase 설정 (Firebase Console > Project Settings > General에서 확인)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# 게임 설정 (상용 환경 - 정식 룰)
VITE_MAX_PLAYERS=5                # 최소 게임 인원 (5인 + AI 1인)
VITE_MAX_TURNS=5                  # 최대 턴 수
VITE_ANSWER_TIME_LIMIT=90         # 답변 제한 시간 (초)
VITE_VOTE_TIME_LIMIT=60           # 투표 제한 시간 (초)

# 디버깅 설정
VITE_ENABLE_CONSOLE_LOG=false     # console.log 출력 비활성화 (성능 최적화)
