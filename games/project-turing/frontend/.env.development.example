# Frontend Development Environment Variables
# 개발 환경 전용 설정

# 환경 구분
VITE_ENV=DEV

# Firebase 설정 (Firebase Console > Project Settings > General에서 확인)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# 게임 설정 (개발 환경 - 테스트 용이성)
VITE_MAX_PLAYERS=2                # 최소 게임 인원 (빠른 매칭 테스트)
VITE_MAX_TURNS=3                  # 최대 턴 수 (빠른 게임 종료)
VITE_ANSWER_TIME_LIMIT=30         # 답변 제한 시간 (초)
VITE_VOTE_TIME_LIMIT=20           # 투표 제한 시간 (초)

# 디버깅 설정
VITE_ENABLE_CONSOLE_LOG=true      # console.log 출력 활성화
