#!/usr/bin/env sh

echo "🧪 Running pre-push tests..."

# 현재 브랜치에서 변경된 파일 확인 (origin과 비교)
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
CHANGED_FILES=$(git diff --name-only origin/$CURRENT_BRANCH..HEAD 2>/dev/null || git diff --name-only HEAD)

DA_VINCI_CHANGED=$(echo "$CHANGED_FILES" | grep "^games/project-da-vinci/frontend/" || true)
TURING_CHANGED=$(echo "$CHANGED_FILES" | grep "^games/project-turing/frontend/" || true)

# 변경된 프로젝트가 없으면 통과
if [ -z "$DA_VINCI_CHANGED" ] && [ -z "$TURING_CHANGED" ]; then
  echo "ℹ️ No frontend files changed. Skipping tests."
  exit 0
fi

# project-da-vinci 테스트
if [ -n "$DA_VINCI_CHANGED" ]; then
  echo "📦 Testing project-da-vinci..."
  cd games/project-da-vinci/frontend || exit 1

  echo "🧪 Running unit tests..."
  npm run test:run

  if [ $? -ne 0 ]; then
    echo "❌ Da-Vinci unit tests failed. Push aborted."
    exit 1
  fi

  echo "🏗️ Testing build..."
  npm run build

  if [ $? -ne 0 ]; then
    echo "❌ Da-Vinci build failed. Push aborted."
    exit 1
  fi

  cd ../../.. || exit 1
fi

# project-turing 테스트
if [ -n "$TURING_CHANGED" ]; then
  echo "🧠 Testing project-turing..."
  cd games/project-turing/frontend || exit 1

  echo "🧪 Running unit tests..."
  npm run test:run

  if [ $? -ne 0 ]; then
    echo "❌ Turing unit tests failed. Push aborted."
    exit 1
  fi

  echo "🏗️ Testing build..."
  npm run build

  if [ $? -ne 0 ]; then
    echo "❌ Turing build failed. Push aborted."
    exit 1
  fi

  cd ../../.. || exit 1
fi

echo "✅ All pre-push checks passed! Pushing to remote..."
